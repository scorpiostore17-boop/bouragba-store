# ========================================================
# BOURAGBA STORE - ENVIRONMENT CONFIGURATION
# إعدادات بيئة العمل الخاصة بمتجر بوراقبة ستور
# ========================================================

# المنفذ وبيئة التشغيل (PORT & ENVIRONMENT)
PORT=5000
NODE_ENV=development

# كلمة سر لوحة التحكم (Admin Dashboard Password)
# يمكنك تغييرها هنا أو مباشرة من داخل لوحة التحكم (/admin)
ADMIN_PASSWORD=ADMIN123

# إعدادات حساب Cloudinary لرفع وحفظ الصور سحابياً
# للحصول عليها مجاناً: سجل في https://cloudinary.com ثم انسخ البيانات من Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# إعدادات EmailJS لإرسال إشعارات الطلبات ورسائل تواصل معنا إلى بريدك
# للحصول عليها مجاناً: سجل في https://www.emailjs.com
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_TO_EMAIL=info@bouragbastore.dz
