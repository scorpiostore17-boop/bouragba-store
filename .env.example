# ========================================================
# BOURAGBA STORE - ENVIRONMENT TEMPLATE (.env.example)
# نموذج ملف المتغيرات لمتجر بوراقبة ستور - ارفعه إلى GitHub بأمان
# ========================================================
# قم بنسخ هذا الملف إلى .env واملأ البيانات الخاصة بك
# أو أضف هذه المتغيرات في إعدادات المنصة (مثل Railway Environment Variables)

# 1. المنفذ وبيئة التشغيل
PORT=5000
NODE_ENV=production

# 2. كلمة سر لوحة التحكم (Admin Password)
# الكلمة الافتراضية هي ADMIN123، يرجى كتابة كلمة سر قوية هنا أو تغييرها من لوحة الإدارة
ADMIN_PASSWORD=ADMIN123

# 3. إعدادات Cloudinary (لتخزين ورفع صور المنتجات سحابياً بشكل دائم على Railway)
# أنشئ حساباً مجانياً على https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=

# 4. إعدادات EmailJS (لإرسال إشعارات الطلبات ورسائل تواصل معنا بالبريد الإلكتروني)
# أنشئ حساباً مجانياً على https://www.emailjs.com
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_TO_EMAIL=your_email@domain.com
